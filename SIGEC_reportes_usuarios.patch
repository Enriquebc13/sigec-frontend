+  white: '#FFFFFF', muted: '#C9BEDD', purpleDark: '#5E35B1',
+  panel: 'rgba(255,255,255,0.09)', border: 'rgba(255,255,255,0.15)',
+  green: '#86EFAC', red: '#FCA5A5',
+};
+
+const roleName = (role: UserRole) => role === 'ADMIN' ? 'Administrador' : 'Cliente';
+const statusName = (active: boolean) => active ? 'Activo' : 'Inactivo';
+const pad = (value: number) => String(value).padStart(2, '0');
+const formatDate = (date: Date) => Number.isNaN(date.getTime()) ? '—' : date.toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' });
+const monthKey = (year: number, month: number) => `${year}-${pad(month + 1)}`;
+const escapeCsvCell = (value: unknown) => `"${String(value ?? '').replace(/"/g, '""')}"`;
+
+function buildMonthlyRows(users: User[], from?: Date, to?: Date, allUsers: User[] = users): MonthlyRow[] {
+  const validDates = allUsers.map(user => user.createdAt).filter(date => date instanceof Date && !Number.isNaN(date.getTime()));
+  if (!validDates.length && !from) return [];
+
+  const earliest = from ?? new Date(Math.min(...validDates.map(date => date.getTime())));
+  const latest = to ?? new Date();
+  const start = new Date(earliest.getFullYear(), earliest.getMonth(), 1);
+  const end = new Date(latest.getFullYear(), latest.getMonth(), 1);
+  if (start > end) return [];
+
+  const counts = new Map<string, number>();
+  users.forEach(user => {
+    if (!(user.createdAt instanceof Date) || Number.isNaN(user.createdAt.getTime())) return;
+    const key = monthKey(user.createdAt.getFullYear(), user.createdAt.getMonth());
+    counts.set(key, (counts.get(key) ?? 0) + 1);
+  });
+
+  const rows: MonthlyRow[] = [];
+  let accumulated = 0;
+  const cursor = new Date(start);
+  while (cursor <= end) {
+    const key = monthKey(cursor.getFullYear(), cursor.getMonth());
+    const registrations = counts.get(key) ?? 0;
+    accumulated += registrations;
+    rows.push({
+      key,
+      month: cursor.toLocaleDateString('es-MX', { month: 'long', year: 'numeric' }),
+      registrations,
+      accumulated,
+    });
+    cursor.setMonth(cursor.getMonth() + 1);
+  }
+  return rows;
+}
+
+function downloadWorkbook(filename: string, sheets: { name: string; rows: Record<string, unknown>[] }[]) {
+  try {
+    const workbook = XLSX.utils.book_new();
+    sheets.forEach(sheet => {
+      const worksheet = XLSX.utils.json_to_sheet(sheet.rows);
+      XLSX.utils.book_append_sheet(workbook, worksheet, sheet.name.slice(0, 31));
+    });
+
+    if (Platform.OS === 'web') {
+      XLSX.writeFile(workbook, filename, { bookType: 'xlsx' });
+      return;
+    }
+
+    const base64 = XLSX.write(workbook, { bookType: 'xlsx', type: 'base64' });
+    const directory = FileSystem.cacheDirectory;
+    if (!directory) throw new Error('No se encontró el directorio temporal para guardar el archivo.');
+    const fileUri = `${directory}${filename}`;
+    void FileSystem.writeAsStringAsync(fileUri, base64, { encoding: FileSystem.EncodingType.Base64 })
+      .then(async () => {
+        const available = await Sharing.isAvailableAsync();
+        if (!available) throw new Error('La opción de compartir archivos no está disponible en este dispositivo.');
+        await Sharing.shareAsync(fileUri, {
+          mimeType: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
+          dialogTitle: 'Exportar reporte de usuarios',
+          UTI: 'org.openxmlformats.spreadsheetml.sheet',
+        });
+      })
+      .catch(error => Alert.alert('No se pudo exportar', error?.message ?? 'Intenta nuevamente.'));
+  } catch (error: any) {
+    Alert.alert('No se pudo exportar', error?.message ?? 'Ocurrió un error al generar el Excel.');
+  }
+}
